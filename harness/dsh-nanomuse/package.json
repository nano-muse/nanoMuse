{
  "name": "dsh-nanomuse",
  "version": "1.0.9",
  "description": "nanoMuse as a DeepSeek Harness bundle: the account, the face, the persona, Hands and Reach of a Muse-style personal agent, as plugins.",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nano-muse/nanoMuse.git",
    "directory": "harness/dsh-nanomuse"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cloud": {
      "types": "./lib/types/cloud.d.ts",
      "default": "./lib/cloud.js"
    },
    "./reach": {
      "types": "./lib/types/reach.d.ts",
      "default": "./lib/reach.js"
    },
    "./rooms": {
      "types": "./lib/types/rooms.d.ts",
      "default": "./lib/rooms.js"
    },
    "./rooms-tools": {
      "types": "./lib/types/rooms-tools.d.ts",
      "default": "./lib/rooms-tools.js"
    },
    "./connectors": {
      "types": "./lib/types/connectors.d.ts",
      "default": "./lib/connectors.js"
    },
    "./connectors-tools": {
      "types": "./lib/types/connectors-tools.d.ts",
      "default": "./lib/connectors-tools.js"
    },
    "./capability-skill": {
      "types": "./lib/types/capability-skill.d.ts",
      "default": "./lib/capability-skill.js"
    },
    "./skills": {
      "types": "./lib/types/skills.d.ts",
      "default": "./lib/skills.js"
    },
    "./hands-tools": {
      "types": "./lib/types/hands-tools.d.ts",
      "default": "./lib/hands-tools.js"
    },
    "./windows-pwsh-sandbox": {
      "types": "./lib/types/windows-pwsh-sandbox.d.ts",
      "default": "./lib/windows-pwsh-sandbox.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "presets"
  ],
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/nanomuse.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-pwsh-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.0-rc.2",
    "@deepseek-ai/dsh-pwsh-local": "0.2.0-rc.2",
    "@deepseek-ai/dsh-pwsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-windows-acl": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.0-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "@types/node": "^24.19.2",
    "@types/react": "~18.3.1",
    "@types/react-dom": "18.3.1",
    "esbuild": "^0.28.2",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "typescript": "^5.9.0"
  }
}
