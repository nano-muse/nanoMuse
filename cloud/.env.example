# nanoMuse Cloud — copy to .env and fill in. Never commit .env.

# Public hostname (Caddy) and what the app is told to use as base URL.
CLOUD_DOMAIN=cloud.example.com
PUBLIC_BASE=https://cloud.example.com
# The SQLite database (docker-compose mounts ./data).
# CLOUD_DB=./data/cloud.db
# Where Let's Encrypt writes when a certificate is about to expire and could not
# be renewed. Optional; scripts/self-host.sh asks for it.
ACME_EMAIL=

# Long random strings (openssl rand -hex 32). CLOUD_SECRET keys the HMAC that
# hashes phone numbers and e-mail addresses (the lookup key), the AES-GCM that
# stores them for the admin page, and the hash of a sign-in code still waiting;
# rotating it orphans every account and every code in the air, so back it up
# with the database. A relay that sends codes (CODE_SENDER other than log) will
# not start without it. CLOUD_ADMIN_TOKEN opens /app/admin/ and the
# /v1/admin/* calls.
CLOUD_SECRET=
CLOUD_ADMIN_TOKEN=

# The provider the relay spends your money on (OpenAI-compatible endpoint).
# Defaults are Alibaba Model Studio (百炼); the same key serves both hosts.
UPSTREAM_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_KEY=
DASHSCOPE_BASE=https://dashscope.aliyuncs.com/api/v1
# Pictures: at most this many drawn at once for everyone (the provider allows an account
# only a couple; more queue here), and 429/5xx retried this often before 429 provider_busy.
# IMAGE_CONCURRENCY=2
# IMAGE_RETRIES=4
# Merged into every chat request for fields the app did not set.
CHAT_DEFAULTS={"enable_thinking": false}
# How long one upstream call may take, in seconds, and how many of an account's
# requests may be under way at once (each holds a reservation against the allowance
# while it runs, so several cannot pass the check together and overshoot it).
# UPSTREAM_TIMEOUT_S=180
# MAX_IN_FLIGHT=4
# Members may ask for any model under the operator's key by its id, and the models the
# provider lists under that key are offered to them after the menu (re-read every
# CLOUD_CATALOG_TTL_S; each one probed once for whether it answers and reads a picture,
# the answer kept for CLOUD_CATALOG_PROBE_TTL_S). 0 switches each off.
# CLOUD_ANY_MODEL_MEMBERS=1
# CLOUD_CATALOG=1
# CLOUD_CATALOG_TTL_S=3600
# CLOUD_CATALOG_PROBE=1
# CLOUD_CATALOG_PROBE_TTL_S=604800

# Who may sign in. SIGNUP_OPEN=1 (the default) lets anyone with a number or an
# address register. The members below (comma-separated phone numbers / e-mail
# addresses) have no spend limit — the operator and friends; with
# SIGNUP_OPEN=0 they are the only ones who may sign in at all (a private relay).
# The admin page can also make any account a member without a restart.
SIGNUP_OPEN=1
ALLOWED_IDENTIFIERS=

# For an app store's review (both empty = off). A reviewer cannot receive our
# codes: for the e-mail addresses below a code request sends nothing and the
# six-digit REVIEW_CODE signs in, under the usual lifetime, attempt and rate
# limits. The account is an ordinary one, tagged "review" on the admin page
# and left out of its sign-up counts. The same two values go into the review
# notes in App Store Connect.
REVIEW_ADDRESSES=
REVIEW_CODE=

# Money (0.5). Everyone who is not a member has ALLOWANCE_CNY yuan for the
# account's lifetime — not a day — counted at the list prices in config.py (or
# CLOUD_MODELS) across chat, pictures and clips alike; 0 = no limit. The pool
# grows by INVITE_BONUS_CNY per new person who signs up with the account's
# invite code — the newcomer's pool grows by the same — and by whatever the
# admin page credits. When it is spent the apps offer that way and another:
# one's own model key or a plan they already pay for (OWN_KEY_DOCS is the guide they
# open — every provider by region and what each covers; OPENROUTER_URL the key page
# for people outside mainland China, whom Bailian does not sign up — 0.17 orders the
# two by the person's region, 0.21 sends the whole list as `guidance` from
# nanomuse_cloud/providers.json); sign-in and the hub keep working,
# only the model routes are gated. DAY_OFFSET_H only groups the operator's
# reports by local day (8 = Beijing). USD_CNY is for showing dollars next to yuan.
ALLOWANCE_CNY=10
INVITE_BONUS_CNY=5
INVITE_URL=https://nanomuse.cn/web/?invite=
OWN_KEY_DOCS=https://nanomuse.cn/own-key
OPENROUTER_URL=https://openrouter.ai/keys

# Data controls (0.9). "Help improve nanoMuse's AI models" keeps the text of an
# account's chat turns — what the person wrote, what the model answered and the
# tool calls it chose; never the system prompt, a tool's result or a picture —
# for the community's own model. IMPROVE_DEFAULT is what an account created
# from now on starts with: 1 = on until the person turns it off under Settings
# → Data controls, 0 = off until they turn it on. Accounts from before keep
# their setting. Say the default in the policy you link as PRIVACY_URL; the
# apps show it next to the switch.
IMPROVE_DEFAULT=0
PRIVACY_URL=https://nanomuse.cn/privacy/
DAY_OFFSET_H=8
USD_CNY=7.1

# Tokens (the older allowance, still enforced when set). One phone/e-mail =
# one grant; 0 switches a limit off: SIGNUP_TOKENS=0 means no token ceiling at
# all (usage is still metered and shown as 「不限」 in the apps),
# DAILY_CAP_TOKENS=0 no daily token cap, PER_MINUTE_REQUESTS=0 no rate limit.
# The per-minute limit is what keeps a runaway loop from spending the whole
# allowance in one go.
SIGNUP_TOKENS=0
DAILY_CAP_TOKENS=0
PER_MINUTE_REQUESTS=30

# The largest request body the relay reads, in bytes (default 16 MiB since
# 0.20; it was 6). A chat request with the hands' last four screenshots fits
# with room; over the limit the answer is 413 `too_large` and says both sizes.
# A proxy in front needs a limit at least this high (the Caddy site in
# deploy/ allows 20 MB).
# MAX_REQUEST_BYTES=16777216

# Whose X-Forwarded-For to believe: the proxy in front. Comma-separated addresses or
# networks; empty = every loopback, private, link-local and shared (100.64/10) address,
# which covers Caddy on this box or the compose network and a tailnet. A relay reached
# straight from the internet ignores the header, so a request cannot name its own address.
# TRUSTED_PROXIES=

# Codes and passwords. A code lives CODE_TTL_S seconds and may be tried
# CODE_MAX_ATTEMPTS times; one number or address gets CODE_PER_IDENTIFIER_10M codes
# per ten minutes, one network address CODE_PER_IP_HOUR per hour. A password (optional,
# on top of the code) is at least PASSWORD_MIN_LEN characters; PASSWORD_MAX_ATTEMPTS
# wrong ones in a row lock it for LOCKOUT_S seconds (a code still works), and
# LOGIN_FAIL_PER_IP_HOUR wrong passwords from one address across all accounts per hour
# stop a list of numbers tried once each. After a sign-in with a code, a new password
# may be set without the old one for PASSWORD_RESET_WINDOW_S seconds.
# CODE_TTL_S=600
# CODE_MAX_ATTEMPTS=5
# CODE_PER_IDENTIFIER_10M=3
# CODE_PER_IP_HOUR=10
# PASSWORD_MIN_LEN=8
# PASSWORD_MAX_ATTEMPTS=5
# LOCKOUT_S=900
# LOGIN_FAIL_PER_IP_HOUR=30
# PASSWORD_RESET_WINDOW_S=1800

# How verification codes go out: log | smtp | aliyun | both
# log   — printed to the server log only (development)
# smtp  — e-mail addresses only
# aliyun — mainland phone numbers through Alibaba Cloud SMS (ALIYUN_SMS_API below picks the API)
# both  — smtp for e-mail, aliyun for phones
CODE_SENDER=log
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nanoMuse <no-reply@example.com>
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN=
ALIYUN_SMS_TEMPLATE=
# dypns = 号码认证服务 SendSmsVerifyCode (the default); dysms = 短信服务 SendSms
# ALIYUN_SMS_API=dypns

# Optional: replace the model menu (JSON list of ModelSpec fields; kind is
# chat | image | video, images cost per_image tokens each, clips per_clip;
# price_in / price_out are the provider's list prices in yuan per million tokens;
# price_in_idle / price_out_idle and idle_hours [start, end] (Beijing time) for a
# model priced by the hour; cached_in_rate is what a cached prompt token costs as a
# share of a fresh one; price_image_in per picture sent in; price_second_res an
# object of per-second prices by resolution above the base, {"720P": 0.2}).
# A chat model says what it is "for": ["chat"], ["gui"] or both (0.17 — the apps'
# pickers filter on it; left out = ["chat"]), and "recommended_for" names the
# lane(s) it is the default pick in (needs "recommended": true; exactly one chat
# model per lane, or the log says so at start). Picture and clip models take no lanes.
# Shipped: deepseek-v4.1-flash (recommended for chat, sees pictures, ¥2 / ¥8),
# qwen3.8-27b (for gui and chat, recommended for gui, ¥3 / ¥12), qwen3.8-flash
# (chat, 0.3×), qwen-image-3.0 (pictures), wan2.2-i2v-flash and wan2.2-t2v-plus (clips).
# CLOUD_MODELS=[{"id":"deepseek-v4.1-flash","name":"DeepSeek V4.1 Flash","upstream":"deepseek-v4.1-flash","input_modalities":["text","image"],"for":["chat"],"recommended":true,"recommended_for":["chat"],"in_mult":0.7,"out_mult":0.7,"price_in":2.0,"price_out":8.0},{"id":"qwen3.8-27b","name":"Qwen 3.8 27B","upstream":"qwen3.8-27b","input_modalities":["text","image"],"for":["gui","chat"],"recommended":true,"recommended_for":["gui"],"price_in":3.0,"price_out":12.0}]

# Devices (the hub): every signed-in device keeps a WebSocket to /v1/hub so the
# account's phones, computers and the web console (/app) reach each other from
# any network. HUB_FRAME_LIMIT caps one frame (files and screenshots travel
# base64 inside frames).
HUB_ENABLED=true
HUB_FRAME_LIMIT=16777216

# The operator's page (0.22). The relay reads the repository's stars, forks,
# watchers, open issues and release downloads from GitHub every six hours and
# keeps one row per day for the Site page. GITHUB_REPO is owner/name (read off
# REPO_URL when empty); GITHUB_TOKEN is optional — without one GitHub allows 60
# requests an hour and the collector uses two; GITHUB_COLLECT=0 turns it off.
# ADMIN_EMAIL is where a threshold rule's "notify" goes (Controls page), through
# the SMTP_* settings above; empty = the rule only writes its audit line.
# GITHUB_REPO=nano-muse/nanoMuse
# GITHUB_TOKEN=
# GITHUB_COLLECT=1
# GITHUB_API=https://api.github.com
ADMIN_EMAIL=
# ALERT_URL is read by deploy/nanomuse-hk/selfcheck.sh, not by the relay: a webhook that
# takes a JSON {"text": ...}, told when the self-check finds a problem. Empty = log only.
# ALERT_URL=
# REPO_URL is the repository the apps point to when they ask for a star.
# REPO_URL=https://github.com/nano-muse/nanoMuse
# Where an address is — country, province, city — from ip2region's database, fetched
# once into the data directory and read in memory; nobody else is asked. CLOUD_GEOIP=0
# switches it off; CLOUD_GEOIP_DB names the file (default: next to the database);
# CLOUD_GEOIP_V6_URL adds the IPv6 file (37 MB) for relays reached over IPv6.
# CLOUD_GEOIP=1
# CLOUD_GEOIP_DB=
# CLOUD_GEOIP_URL=https://raw.githubusercontent.com/lionsoul2014/ip2region/master/data/ip2region_v4.xdb
# CLOUD_GEOIP_V6_URL=
# Panels on the operator's page that read other services, each off when empty: the
# site's traffic database (demo/showcase/mirror/traffic.py, mounted read-only), nanoMuse
# Web's gateway (how many kept accounts and running sessions) and the showcase's admin
# endpoint with its token (who tried the phone in the browser, from where).
# TRAFFIC_DB=
# WEB_INFO_URL=
# WEB_ADMIN_URL=
# WEB_ADMIN_TOKEN=
