  "version": "1.0.1",
  "description": "nanoMuse mobile-first web app (chat, goals, ideas, memory, approvals)",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
